source 'https://rubygems.org'

# Ruby version is pinned via example/.ruby-version (3.2.1). The constraint
# below stays loose to remain compatible with anyone using a slightly older
# 3.x interpreter locally.
ruby ">= 3.2.0"

gem 'cocoapods', '1.16.2'
# activesupport must be >= 7.1 so that it requires 'logger' itself. Older
# versions relied on concurrent-ruby to pull Logger into scope, which broke
# when concurrent-ruby 1.3.5 dropped that implicit require (pod install then
# dies with "uninitialized constant
# ActiveSupport::LoggerThreadSafeLevel::Logger"). CocoaPods 1.16.2 accepts
# activesupport < 8, so the 7.2.x line is the safe landing spot.
gem 'activesupport', '>= 7.2.3.1', '< 8.0'
