# Set environment variables to opt in or out of KlaviyoForms and KlaviyoLocation pods
ENV['KLAVIYO_INCLUDE_FORMS'] = 'true'
ENV['KLAVIYO_INCLUDE_LOCATION'] = 'true'

# Build React-Core from source rather than using the prebuilt binary.
#
# Prebuilt React-Core became the default in React Native 0.84, not 0.86:
# react_native_pods.rb forces ENV['RCT_USE_PREBUILT_RNCORE'] = '1' inside
# use_react_native! unless it is explicitly '0'. This repo went 0.81 -> 0.86
# in one step, so the change surfaced here even though it landed in 0.84.
#
# The prebuilt React-Core exposes its headers non-modularly. Because this Podfile
# builds pods as static frameworks, every `#import <React/...>` from a pod that
# gets a clang module map then trips -Wnon-modular-include-in-framework-module
# under -Werror, and @react-native-firebase fails to compile. Prebuilt React-Core
# also stops incidentally linking Photos, which RNFBApp's RNFBUtilsModule needs
# for PHAsset but never declares in its podspec, so the app fails to link.
#
# Building from source keeps the header and link behaviour we had on 0.81, which
# avoids patching a third-party pod's build settings from here. The cost is a
# slower clean iOS build. Adopting prebuilt React-Core is tracked separately and
# needs @react-native-firebase to declare Photos and support modular imports.
#
# The header incompatibility is confirmed upstream:
# https://github.com/invertase/react-native-firebase/issues/8883
ENV['RCT_USE_PREBUILT_RNCORE'] = '0'

# Force @react-native-firebase pods to build as static frameworks.
# The flag is a no-op in the default RN build
# (static libraries all around) but is required when use_frameworks! is enabled
# below (via USE_FRAMEWORKS env var), because RNFirebase's Swift/ObjC wrappers
# would otherwise default to dynamic linkage and fail to link against
# Firebase's static-only native pods (FirebaseCore, FirebaseMessaging, etc.).
# Kept set unconditionally so `USE_FRAMEWORKS=dynamic pod install` works without
# extra setup. Must be declared before any pod directives so the RNFirebase
# modules see it.
$RNFirebaseAsStaticFramework = true

def node_require(script)
   require Pod::Executable.execute_command('node', ['-p',
     "require.resolve(
       '#{script}',
       {paths: [process.argv[1]]},
     )", __dir__]).strip
 end

node_require('react-native/scripts/react_native_pods.rb')
node_require('react-native-permissions/scripts/setup.rb')

platform :ios, min_ios_version_supported
prepare_react_native_project!

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'KlaviyoReactNativeSdkExample' do
  config = use_native_modules!

  use_frameworks! :linkage => :static

  # Insert override klaviyo-swift-sdk pods below this line when needed

  # Setup permissions for react-native-permissions
  setup_permissions([
    'LocationWhenInUse',
    'LocationAlways',
  ])

  use_react_native!(
    :path => config[:reactNativePath],
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  target 'KlaviyoReactNativeSdkExampleTests' do
    inherit! :complete
    # Pods for testing
  end

  post_install do |installer|
    # https://github.com/facebook/react-native/blob/main/packages/react-native/scripts/react_native_pods.rb#L197-L202
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false
    )
  end
end

target 'KlaviyoReactNativeSdkExampleExtension' do
  use_frameworks! :linkage => :static
  # Insert override klaviyo-swift-sdk extension pod below this line when needed
  pod 'KlaviyoSwiftExtension'
end

